+// CDP Secret API Key -> Bearer JWT (EdDSA), per docs.cdp.coinbase.com/api-reference/v2/authentication:
+// header {alg:EdDSA, typ:JWT, kid, nonce}; claims {sub:kid, iss:"cdp", aud:["cdp_service"], nbf, exp:+120, uri:"POST host/path"}.
+const b64u = (bytes) => btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+const b64uJson = (o) => b64u(new TextEncoder().encode(JSON.stringify(o)));
+export async function cdpJwt(auth, method, url, now = Math.floor(Date.now() / 1000)) {
+  const raw = Uint8Array.from(atob(auth.secret), (ch) => ch.charCodeAt(0));
+  if (raw.length !== 64) throw new Error("CDP_API_KEY_SECRET must be a base64 Ed25519 key (64 bytes)");
+  const key = await crypto.subtle.importKey("jwk", { kty: "OKP", crv: "Ed25519", d: b64u(raw.slice(0, 32)), x: b64u(raw.slice(32)) }, { name: "Ed25519" }, false, ["sign"]);
+  const u = new URL(url);
+  const nonce = [...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, "0")).join("");
+  const head = b64uJson({ alg: "EdDSA", typ: "JWT", kid: auth.keyId, nonce });
+  const claims = b64uJson({ sub: auth.keyId, iss: "cdp", aud: ["cdp_service"], nbf: now, exp: now + 120, uri: `${method} ${u.host}${u.pathname}` });
+  const sig = new Uint8Array(await crypto.subtle.sign({ name: "Ed25519" }, key, new TextEncoder().encode(head + "." + claims)));
+  return head + "." + claims + "." + b64u(sig);
+}
